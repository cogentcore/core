package main

import (
	{{if .Files}}"embed"{{else}}_ "embed"{{end}}
	"os"

	"cogentcore.org/core/events"
	"cogentcore.org/core/core"
)

//go:embed app.exe
var exe []byte
{{if .Files}}
// files are installed next to the executable of the app (the DLLs of
// FFmpeg, and its license).
//
//go:embed files
var files embed.FS
{{end}}
func main() {
	b := core.NewBody("{{.Name}} Installer")
	bt := core.NewButton(b).SetText("Install {{.Name}}")
	bt.OnClick(func(e events.Event) {
		dir := "C:\\Program Files\\{{.Name}}"
		err := os.MkdirAll(dir, 0777)
		core.ErrorDialog(bt, err, "Error installing {{.Name}}")
		err = os.WriteFile(dir+"\\{{.Name}}.exe", exe, 0666)
		core.ErrorDialog(bt, err, "Error installing {{.Name}}")
{{- range .Files}}
		if data, err := files.ReadFile("files/{{.}}"); err == nil {
			err = os.WriteFile(dir+"\\{{.}}", data, 0666)
			core.ErrorDialog(bt, err, "Error installing {{$.Name}}")
		}
{{- end}}
	})
	b.RunMainWindow()
}
